[Unit]
Description=TgAnnouncer Telegram reminder bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=exec
User=tgannouncer
Group=tgannouncer
WorkingDirectory=/opt/tgannouncer
ExecStart=/opt/tgannouncer/.venv/bin/python /opt/tgannouncer/bot.py
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=always
RestartSec=15
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/tgannouncer

[Install]
WantedBy=multi-user.target
